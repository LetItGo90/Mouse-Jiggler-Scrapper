Number of Alerts by reporting period = 
CALCULATE(
    COUNTROWS('Proof Point Alerts'),
    'Proof Point Alerts'[AlertRule] = 'Rule Types'[AlertRule],
    DATESINPERIOD(
        'Proof Point Alerts'[AlertDate],
        TODAY(),
        -30,
        DAY
    )
)


Number of Alerts by reporting period = 
CALCULATE(
    COUNTROWS('Proof Point Alerts'),
    FILTER(
        'Proof Point Alerts',
        'Proof Point Alerts'[AlertRule] = 'Rule Types'[AlertRule]
    ),
    FILTER(
        'Proof Point Alerts',
        'Proof Point Alerts'[AlertDate] >= TODAY() - 30
            && 'Proof Point Alerts'[AlertDate] <= TODAY()
    )
)
