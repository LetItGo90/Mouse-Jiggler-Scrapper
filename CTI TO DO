// Detection: Microsoft Entra Connect (Azure AD Connect) compromise activity
// Covers: ADSync/MSOL_ service account anomalous sign-ins, AADInternals tooling against sync account,
// ADSync database/encryption key extraction, PTA agent registration/reinstallation events
let SyncAccountPattern = dynamic(["MSOL_", "ADSync", "AAD_"]);
let AADInternalsIndicators = dynamic(["AADInternals", "Get-AADIntSyncCredentials", "Export-AADIntSyncCredentials", "Get-AADIntADSyncCredentials"]);
let ADSyncDbIndicators = dynamic(["ADSync.mdf", "ADSync_log.ldf", "mcrypt", "microsoft.identitymanagement.dll"]);
DeviceProcessEvents
| where TimeGenerated > ago(14d)
| where ProcessCommandLine has_any (AADInternalsIndicators) or ProcessCommandLine has_any (ADSyncDbIndicators)
| project TimeGenerated, DeviceName, AccountName, FileName, ProcessCommandLine, InitiatingProcessFileName, ReportId


One way trust
// Detects abuse of a Trusted Domain Object (TDO) password hash to traverse a one-way AD trust
// - 4768/4769 Kerberos ticket requests referencing trust accounts (inter-realm indicators)
// - 4662 DCSync-style replication rights requested against the TDO object
SecurityEvent
| where EventID in (4768, 4769, 4662)
| where
    // Kerberos TGT/service ticket requests for a trust account (trust accounts end in $ and match domain trust naming)
    (EventID in (4768, 4769) and (TargetUserName endswith "$" or ServiceName endswith "$") and (KeyLength == 0 or isnotempty(KeyLength))) // TicketOptions is not in SecurityEvent schema, using existing field as proxy for ticket context
    or
    // DCSync-style replication request rights targeting an object (potential TDO secret extraction)
    (EventID == 4662 and (Properties has "1131f6aa-9c07-11d1-f79f-00c04fc2dcd2" or Properties has "1131f6ad-9c07-11d1-f79f-00c04fc2dcd2") and ObjectType has_any ("trustedDomain", "domainDNS"))
| extend TrustIndicator = case(
    EventID == 4662, "DS-Replication-Get-Changes on TDO",
    EventID in (4768, 4769), "Inter-realm ticket referencing trust account",
    "Unknown")
| project TimeGenerated, EventID, Computer, Account, SubjectUserName, TargetUserName, ServiceName, ObjectType, Properties, TrustIndicator, IpAddress
| sort by TimeGenerated desc



Golden Samle
let adfsSigninAnomalies = SigninLogs
| where AuthenticationProtocol in ("SAML", "WSFed")
| where ResultType == "0"
| where AuthenticationRequirement != "multiFactorAuthentication"
| where isnotempty(tostring(NetworkLocationDetails)) or RiskLevelDuringSignIn in ("medium", "high") or tostring(AuthenticationDetails) has "unfamiliar"
| extend DetectionType = "FederatedSignInMFABypassOrAnomalousLocation"
| project TimeGenerated, UserPrincipalName, AppDisplayName, IPAddress, Location, AuthenticationProtocol, AuthenticationRequirement, RiskLevelDuringSignIn, ConditionalAccessStatus, DetectionType;
let dkmContainerAccess = SecurityEvent
| where EventID == 4662
| where ObjectName has "ADFS" and ObjectName has "DKM"
| extend DetectionType = "ADFS_DKM_ContainerAccess"
| project TimeGenerated, Computer, SubjectAccount = SubjectUserName, SubjectDomainName, ObjectName, AccessMask, DetectionType;
let adfsCertExport = SecurityEvent
| where EventID in (4886, 4887)
| where AdditionalInfo has "certificate" or AdditionalInfo2 has "certificate" or Activity has "Export" or Activity has "Certificate"
| extend DetectionType = "ADFS_TokenSigningCertExportEvent"
| project TimeGenerated, Computer, SubjectAccount = SubjectUserName, Activity, AdditionalInfo, AdditionalInfo2, DetectionType;
union isfuzzy=true adfsSigninAnomalies, dkmContainerAccess, adfsCertExport
| sort by TimeGenerated desc
