index=epa_oms_tenable sourcetype=tenable:sc:vuln earliest=-6mon cve=CVE-*
| mvexpand cve
| stats latest(state) as state, latest(vendor_product) as product,
        latest(dest_fisma_system) as fisma, latest(vpr_score) as vpr,
        latest(epssScore) as epss, latest(exploitFrameworks) as frameworks,
        latest(xref) as xref
  by cve, dest
| where state="Open"
| stats dc(dest) as hosts, values(product) as product, values(fisma) as fisma,
        max(vpr) as vpr, max(epss) as epss, values(frameworks) as frameworks,
        values(xref) as xref
  by cve
| eval kev=if(match(xref,"KNOWN-EXPLOITED"),"Yes","No")
| fields - xref
| sort - kev, - vpr, - hosts
