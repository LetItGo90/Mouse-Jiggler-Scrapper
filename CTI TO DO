index=* EventCode=4688 WmiPrvSE.exe cmd.exe
| rex field=Process_Command_Line "__(?<redirect_epoch>\d{9,11}\.\d+)"
| eval redirect_time=if(isnotnull(redirect_epoch),strftime(redirect_epoch,"%Y-%m-%d %H:%M:%S"),"none (nooutput/other?)")
| stats count min(_time) as firstTime max(_time) as lastTime
    by host Account_Name Creator_Process_Name New_Process_Name redirect_time Process_Command_Line
| convert ctime(firstTime) ctime(lastTime)
